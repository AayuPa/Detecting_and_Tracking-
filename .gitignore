# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/

# ---- Video I/O ----
# Input footage and rendered output are large and change every run.
# Keep them out of history — git never forgets a 2GB mp4.
input_videos/
output_videos/
*.mp4
*.mov
*.avi
*.mkv

*.webm

# Exception: keep a short demo clip/GIF for the README
!assets/demo.gif
!assets/demo.mp4

# ---- Cached intermediates ----
# Pickled detections / track stubs used to skip re-running inference
stubs/
*.pkl
*.pickle
*.npy

# ---- Model weights ----
# Commit small fine-tuned weights if <50MB; otherwise ship via Release/LFS.
# Uncomment the next line if best.pt is too large to version.
# models/*.pt

# Ultralytics writes here during training/prediction
runs/
yolov8*.pt
!models/best.pt

# ---- Notebooks ----
.ipynb_checkpoints/

# ---- Editors / OS ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Secrets / config ----
.env
*.local
